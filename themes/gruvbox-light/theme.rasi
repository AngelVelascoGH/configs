* {
    /* Gruvbox Light Palette */
    bg0:     #fbf1c7;
    bg1:     #ebdbb2;
    bg2:     #d5c4a1;
    bg3:     #bdae93;

    fg0:     #282828;
    fg1:     #3c3836;
    fg2:     #504945;

    red:     #9d0006;
    green:   #79740e;
    yellow:  #b57614;
    blue:    #076678;
    magenta: #8f3f71;
    cyan:    #427b58;

    accent:  @blue;   /* Dark Blue accent is high contrast */
    urgent:  @red;
}
